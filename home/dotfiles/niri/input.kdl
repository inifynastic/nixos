input {
    keyboard {
        xkb {
        	layout "us"

	    }
        // numlock // Enable numlock on start.
    }

    touchpad {
        // off
        tap
        // dwt
        // dwtp
         drag true
        // drag-lock
        // natural-scroll
         accel-speed 0.2
        // accel-profile "flat"
        scroll-method "two-finger"
        // disabled-on-external-mouse
	// scroll-factor
    	}

    mouse {
        // off
        // natural-scroll
        accel-speed -0.5
        // accel-profile "flat"
        // scroll-method "no-scroll"
	// scroll-factor horizontal=2.0 vertical=1.0
    	}
    trackpoint {
	off
	}
    trackball{
	off
	}
    tablet{
	off
	}
    touch{
	off
	}

    // General Settings
	//disable-power-key-handling
	warp-mouse-to-focus
	focus-follows-mouse
	workspace-auto-back-and-forth
	mod-key "Super"
	mod-key-nested "Super"
}