output "eDP-1" {

    // Run `niri msg outputs` while inside a niri instance to list all outputs and their modes.
    //mode "2560x1440@165.003"
    mode "2560x1440@60.000"
    scale 1.7
    transform "normal"
    position x=0 y=0
    //variable-refresh-rate
    focus-at-startup
    //background-color "#00008B"
    //backdrop-color "#000001"
    //hot-corners // I wont touch it for now
}

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=1506 y=0
}
